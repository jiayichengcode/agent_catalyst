# ---- Large experiment artifacts (not source) ----
# models/ ~13G of downloaded model weights
# envs/   ~4.9G of virtualenvs / conda envs
models/
envs/

# runs/ is ~1.5T of checkpoints, but each run's measurement is two small
# JSONL files. Keep those (~1.2M total) so every number in reports/ can be
# recomputed and checked; exclude everything else under runs/.
runs/**
!runs/*/
!runs/*/curve.jsonl
!runs/*/sft_log.jsonl

# ---- Generated donor datasets (~137M, regenerable) ----
data/*.jsonl
transfer-unit/data/*.jsonl

# ---- Python ----
__pycache__/
*.py[cod]
*.so
.venv/
venv/
*.egg-info/
.ipynb_checkpoints/

# ---- Misc ----
.DS_Store
*.swp
